# Same database as apps/hotel-admin / apps/super-admin — one architecture,
# one schema (packages/db), shared by all three portals per the RoomLink dev
# rules.
DATABASE_URL="postgresql://roomlink@localhost:5432/rmdb?schema=public"

# ZegoCloud project credentials for guest-to-reception voice calling
# (src/server/zego-token.ts). Must be the same ZegoCloud project as
# apps/hotel-admin's — App ID is safe to expose to the client (the
# call-invitation UIKit needs it in the browser); the server secret must
# never be. Voice-call token routes throw a clear config error if either is
# missing.
NEXT_PUBLIC_ZEGOCLOUD_APP_ID="replace-with-your-zego-app-id"
ZEGOCLOUD_SERVER_SECRET="replace-with-your-32-byte-zego-server-secret"
